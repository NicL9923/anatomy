{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:next": "next build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern public/basis --ignore-pattern public/draco",
    "db:generate": "drizzle-kit generate",
    "i18n:audit": "tsx scripts/i18n-audit.mjs",
    "i18n:export": "tsx scripts/i18n-export.mjs",
    "typecheck": "node node_modules/@typescript/native-preview/bin/tsgo --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.15.0",
    "lucide-react": "^1.66.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@cloudflare/workers-types": "^5.20261031.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "react-server-dom-webpack": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vinext": "^1.4.0",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  },
  "type": "module"
}
